<?xml version="1.0"?>
<ruleset name="Codegenie Pulse Connector">
    <description>WordPress Coding Standards for runtime PHP.</description>
    <file>codegenie-pulse-connector.php</file>
    <file>index.php</file>
    <file>includes</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress.Security"/>
    <config name="minimum_supported_wp_version" value="6.2"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="codegenie-pulse-connector"/>
            </property>
        </properties>
    </rule>
</ruleset>
