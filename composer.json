{
    "name": "codegenie-be/codegenie-pulse-connector-wordpress",
    "description": "Development tooling for the Codegenie Pulse Connector WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1.8",
        "phpunit/phpunit": "^9.6.35",
        "wp-coding-standards/wpcs": "^3.4.0",
        "yoast/phpunit-polyfills": "^4.0.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "scripts": {
        "syntax": "php scripts/check-syntax.php",
        "compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- --extensions=php --ignore=vendor/*,dist/* .",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "test": "phpunit --configuration phpunit.xml.dist",
        "policy": "php scripts/check-repository.php",
        "versions": "php scripts/check-versions.php",
        "security-audit": "composer audit --locked --no-interaction",
        "qa": [
            "@syntax",
            "@compat",
            "@cs",
            "@test",
            "@versions",
            "@policy",
            "@security-audit"
        ],
        "build": "php scripts/build-release.php"
    }
}
